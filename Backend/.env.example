# Compose uses POSTGRES_PASSWORD; the API constructs a PostgreSQL URL safely from these fields.
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=visitorhub
DATABASE_USER=visitorhub
DATABASE_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-secret
# Separate secret used to hash password-reset tokens; never reuse JWT_SECRET.
TOKEN_PEPPER=replace-with-a-different-long-random-secret
# Encrypts the re-displayable copy of active QR pass tokens. Changing it stops existing passes from being re-shown (they still scan).
PASS_ENCRYPTION_KEY=replace-with-a-third-long-random-secret
# development enables the console reset-link delivery below; anything else refuses it.
APP_ENV=development
# console (development only): emails (reset links, notification copies) are printed to the container's stderr. disabled: nothing is sent.
EMAIL_DELIVERY=console
DASHBOARD_URL=http://localhost:3000
INITIAL_SETUP_KEY=replace-with-a-long-one-time-setup-secret
POSTGRES_PASSWORD=replace-with-a-database-password
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5173
VITE_API_URL=http://localhost:8000/api/v1
