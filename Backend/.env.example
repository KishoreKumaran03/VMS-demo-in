# Compose uses POSTGRES_PASSWORD; the API constructs a PostgreSQL URL safely from these fields.
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=visitorhub
DATABASE_USER=visitorhub
DATABASE_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-secret
INITIAL_SETUP_KEY=replace-with-a-long-one-time-setup-secret
POSTGRES_PASSWORD=replace-with-a-database-password
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5173
VITE_API_URL=http://localhost:8000/api/v1
# Local demo bootstrap uses this stable development site UUID. Set the matching value before
# building the kiosk for a different site.
VITE_KIOSK_SITE_ID=00000000-0000-4000-8000-000000000001
